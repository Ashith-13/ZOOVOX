# ══════════════════════════════════════════════════════════════════════════════
# ZOOVOX Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ZOOVOX
ENVIRONMENT=development
DEBUG=false

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Create free cluster at https://cloud.mongodb.com
# Connection string → Connect → Drivers → Python
MONGODB_URL=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxxx.mongodb.net/zoovox?retryWrites=true&w=majority
MONGODB_DB_NAME=zoovox

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Google APIs ──────────────────────────────────────────────────────────────
# Enable: Maps JavaScript API, Places API, Translate API
# https://console.cloud.google.com/apis/
GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_TRANSLATE_API_KEY=AIza...

# ── Cloudinary (audio + image storage) ───────────────────────────────────────
# Free plan: 25 GB storage at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Redis (optional but recommended for production) ───────────────────────────
# Free tier: https://upstash.com or https://redis.com/try-free/
REDIS_URL=redis://localhost:6379/0

# ── Email (optional — user verification) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM=noreply@zoovox.app

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── ML Model Paths ────────────────────────────────────────────────────────────
YAMNET_MODEL_PATH=models/yamnet
VGGISH_MODEL_PATH=models/vggish
ZOOVOX_CLASSIFIER_PATH=models/zoovox_classifier.pkl
AUDIO_MAX_FILE_MB=10
AUDIO_MAX_DURATION_SECONDS=30
